# Copy to .env next to compose.yaml and fill in.

# Image tag to run: the git commit the image was built from.
FLEETRANGER_VERSION=

# Directory holding persistent data (database files, raw flight logs).
FLEETRANGER_DATA_DIR=/srv/fleetranger/data

# Use a long random value, e.g. from `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# RUST_LOG=info
