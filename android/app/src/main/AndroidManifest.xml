<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- DJI Pilot 2 is opened by package name, so it must be visible to the app. -->
    <queries>
        <package android:name="com.dji.industry.pilot" />
    </queries>

    <application
        android:label="FleetRanger"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The download page's link: fleetranger://setup?server=https://… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fleetranger" android:host="setup" />
            </intent-filter>
        </activity>
    </application>
</manifest>
