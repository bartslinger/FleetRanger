  "query": "select r.path, r.status, r.last_error as error, f.id as \"flight_id?\"\n           from raw_logs r\n           left join flights f on f.raw_log_id = r.id\n           where r.status <> 'pending' and r.processed_at >= $1\n           order by r.processed_at desc, r.id\n           limit $2",
