{
	"name": "fleetranger-web",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": "24.22.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tokens": "node scripts/tokens.js && prettier --write src/lib/ui/tokens.css"
	},
	"devDependencies": {
		"@carbon/charts": "1.27.21",
		"@carbon/charts-svelte": "1.27.21",
		"@carbon/icons": "11.90.0",
		"@carbon/layout": "11.61.0",
		"@carbon/themes": "11.83.0",
		"@carbon/type": "11.69.0",
		"@eslint/js": "^10.0.1",
		"@ibm/plex-mono": "2.5.0",
		"@ibm/plex-sans": "1.1.0",
		"@internationalized/date": "3.12.4",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"bits-ui": "2.19.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mapbox-gl": "3.32.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"terra-draw": "1.38.0",
		"terra-draw-mapbox-gl-adapter": "1.5.0"
	}
}
