  "query": "select c.id, c.name, c.redirect_uris, c.created_at,\n                  (select count(distinct g.user_id) from oauth_grants g where g.client_id = c.id)\n                      as \"users!\"\n           from oauth_clients c\n           where c.trusted\n           order by lower(c.name), c.id",
