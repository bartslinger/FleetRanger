  "query": "select t.id, t.name, t.archived_at,\n                  (select count(*) from team_members m join pilots p on p.id = m.pilot_id\n                   where m.team_id = t.id and p.archived_at is null) as \"pilots!\"\n           from teams t\n           where t.id = $1",
