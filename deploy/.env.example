# Copy to .env next to compose.yaml and fill in.

# Release to run: the vX.Y.Z tag the images were built from (ship-image.sh).
FLEETRANGER_VERSION=

# Directory holding persistent data: postgres/ (database files), flightlogs/
# (raw flight logs) and android/ (the app on the download page).
FLEETRANGER_DATA_DIR=/srv/fleetranger/data

# The address users open, e.g. https://fleet.example.org.
FLEETRANGER_PUBLIC_URL=

# The organisation's time zone; all times are shown in it, e.g. Europe/Amsterdam.
TIME_ZONE=UTC

# Secrets. Use a long random value for the database, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# DJI's app key, for the keys that decrypt flight logs; without it no log is processed.
DJI_APP_KEY=
# Login with an OpenID Connect provider (e.g. https://accounts.google.com); the
# redirect URI to register is FLEETRANGER_PUBLIC_URL + /auth/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# A public Mapbox token (pk.…) restricted to FLEETRANGER_PUBLIC_URL; without one, pages show no map.
MAPBOX_ACCESS_TOKEN=

# Optional: the break that ends a session, in minutes (default 120).
# FLEETRANGER_SESSION_GAP_MINUTES=120
# RUST_LOG=info
