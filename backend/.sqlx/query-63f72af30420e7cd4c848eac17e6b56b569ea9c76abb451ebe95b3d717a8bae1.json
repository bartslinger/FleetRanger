{
  "db_name": "PostgreSQL",
  "query": "select g.id, c.name as app,\n                  coalesce(substring(c.redirect_uris[1] from '^[a-z]+://([^/:?#]+)'), '')\n                      as \"host!\",\n                  g.scopes, g.created_at, g.last_used_at\n           from oauth_grants g join oauth_clients c on c.id = g.client_id\n           where g.user_id = $1\n           order by g.created_at desc",
